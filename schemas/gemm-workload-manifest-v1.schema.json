{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apxinf.local/schemas/gemm-workload-manifest-v1.schema.json",
  "title": "Family-neutral GEMM workload manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "tunable_object", "workloads"],
  "properties": {
    "schema": {"const": "apxinf.tuning.gemm-workloads.v1"},
    "tunable_object": {"const": "gemm"},
    "workloads": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/workload"}
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device_name", "sm", "multiprocessor_count", "kernel_build_id", "cuda_version", "library_versions"],
      "properties": {
        "device_name": {"type": "string", "minLength": 1},
        "sm": {"type": "integer", "minimum": 1},
        "multiprocessor_count": {"type": "integer", "minimum": 1},
        "kernel_build_id": {"type": "string", "minLength": 1},
        "cuda_version": {"type": "string", "minLength": 1},
        "library_versions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string", "minLength": 1}
        }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "m", "n", "k", "activation_dtype", "weight_dtype", "output_dtype", "layout", "scale_mode", "epilogue", "workspace_limit", "family", "logical_phase", "source_operation", "profile", "repetitions", "target_fingerprint", "estimated_milliseconds_saved", "best_current_milliseconds"],
      "properties": {
        "op": {"enum": ["bf16", "w8a8", "fp8_f16"]},
        "m": {"type": "integer", "minimum": 1},
        "n": {"type": "integer", "minimum": 1},
        "k": {"type": "integer", "minimum": 1},
        "activation_dtype": {"enum": ["f32", "f16", "bf16", "f8e4m3", "i8", "i32"]},
        "weight_dtype": {"enum": ["f32", "f16", "bf16", "f8e4m3", "i8", "i32"]},
        "output_dtype": {"enum": ["f32", "f16", "bf16", "f8e4m3", "i8", "i32"]},
        "layout": {"enum": ["row_major", "weight_output_major"]},
        "scale_mode": {"enum": ["none", "per_tensor", "dynamic_row_per_output_channel"]},
        "epilogue": {"enum": ["none", "bias", "bias_gelu", "bias_residual"]},
        "workspace_limit": {"type": "integer", "minimum": 0},
        "family": {"type": "string", "minLength": 1},
        "logical_phase": {"enum": ["vision", "prefill", "decode", "action"]},
        "source_operation": {"type": "string", "minLength": 1},
        "profile": {"type": "string", "minLength": 1},
        "repetitions": {"type": "integer", "minimum": 1},
        "target_fingerprint": {"$ref": "#/$defs/target"},
        "estimated_milliseconds_saved": {"type": "number", "minimum": 0},
        "best_current_milliseconds": {"type": "number", "minimum": 0}
      }
    }
  }
}
