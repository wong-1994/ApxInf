{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apxinf.dev/schemas/capability-gap-report-v1.schema.json",
  "title": "ApxInf Capability Contract gap report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "port_id",
    "category",
    "contract",
    "source_inventory_sha256",
    "gaps"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "port_id": {"type": "string", "minLength": 1},
    "category": {"const": "unsupported_semantics"},
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sha256"],
      "properties": {
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "source_inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gaps": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "capability-classification-v1.schema.json#/$defs/classification"}
    }
  }
}
