{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apxinf.dev/schemas/port-request-v1.schema.json",
  "title": "ApxInf Port request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "port_id",
    "source",
    "checkpoint",
    "representative_profiles",
    "requested_targets",
    "correctness_thresholds",
    "tuning_budgets",
    "user_environment_declarations"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "port_id": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "revision", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "representative_profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "inputs"],
        "properties": {
          "name": {"type": ["string", "null"], "minLength": 1},
          "inputs": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    },
    "requested_targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "precision", "latency_goal"],
        "properties": {
          "target": {"enum": ["thor", "orin", null]},
          "precision": {"enum": ["bf16", "fp8", "int8_w8a8", null]},
          "latency_goal": {
            "type": "object",
            "additionalProperties": false,
            "required": ["p50_ms", "p95_ms"],
            "properties": {
              "p50_ms": {"type": ["number", "null"], "exclusiveMinimum": 0},
              "p95_ms": {"type": ["number", "null"], "exclusiveMinimum": 0}
            }
          }
        }
      }
    },
    "correctness_thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["absolute", "relative"],
      "properties": {
        "absolute": {"type": ["number", "null"], "minimum": 0},
        "relative": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "tuning_budgets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "seconds"],
        "properties": {
          "target": {"enum": ["thor", "orin", null]},
          "seconds": {"type": ["number", "null"], "exclusiveMinimum": 0}
        }
      }
    },
    "user_environment_declarations": {"type": "object"}
  }
}
