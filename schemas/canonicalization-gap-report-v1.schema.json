{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apxinf.dev/schemas/canonicalization-gap-report-v1.schema.json",
  "title": "ApxInf Canonical VLA equivalence gap report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "port_id", "category", "contract", "source_inventory_sha256", "gaps"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "port_id": {"type": "string", "minLength": 1},
    "category": {"const": "correctness_failure"},
    "contract": {"type": "object"},
    "source_inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gaps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "message"],
        "properties": {
          "kind": {"enum": ["incomplete_canonicalization", "numerical_mismatch"]},
          "path": {"type": "string", "minLength": 1},
          "message": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
