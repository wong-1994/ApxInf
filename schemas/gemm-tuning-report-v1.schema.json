{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apxinf.local/schemas/gemm-tuning-report-v1.schema.json",
  "title": "Budgeted GEMM tuning report v1",
  "type": "object",
  "required": ["schema", "family", "profile", "target_fingerprint", "budget_seconds", "seconds_spent", "coverage", "best_current_results", "remaining_hotspots", "tactics", "complete_inference_correctness"],
  "properties": {
    "schema": {"const": "apxinf.tuning.report.v1"},
    "family": {"type": "string", "minLength": 1},
    "profile": {"type": "string", "minLength": 1},
    "budget_seconds": {"type": "number", "minimum": 0},
    "seconds_spent": {"type": "number", "minimum": 0},
    "coverage": {
      "type": "object",
      "required": ["tuned", "total"],
      "properties": {
        "tuned": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 0}
      }
    },
    "best_current_results": {"type": "array"},
    "remaining_hotspots": {"type": "array"},
    "tactics": {"type": "object"},
    "complete_inference_correctness": {"const": true}
  }
}
