{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apxinf.local/schemas/gemm-tactic-manifest-v1.schema.json",
  "title": "Environment-bound GEMM tactics v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kernel_build_id", "device_name", "sm", "multiprocessor_count", "cuda_version", "cublas_version", "library_versions", "records"],
  "properties": {
    "schema": {"const": "apxinf.cuda.tuning.v1"},
    "kernel_build_id": {"type": "string", "minLength": 1},
    "device_name": {"type": "string", "minLength": 1},
    "sm": {"type": "integer", "minimum": 1},
    "multiprocessor_count": {"type": "integer", "minimum": 1},
    "cuda_version": {"type": "string", "minLength": 1},
    "cublas_version": {"type": "string", "minLength": 1},
    "library_versions": {
      "type": "object",
      "required": ["cublas"],
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_operation", "logical_phase", "profile", "key", "tactic", "milliseconds", "device_name", "device", "kernel_build_id", "cuda_version", "library_versions"],
        "properties": {
          "source_operation": {"type": "string", "minLength": 1},
          "logical_phase": {"enum": ["vision", "prefill", "decode", "action"]},
          "profile": {"type": "string", "minLength": 1},
          "key": {"type": "object"},
          "tactic": {
            "type": "object",
            "required": ["backend", "id"],
            "properties": {
              "backend": {"type": "string", "minLength": 1},
              "id": {"type": "integer", "minimum": 0}
            }
          },
          "milliseconds": {"type": "number", "minimum": 0},
          "device_name": {"type": "string", "minLength": 1},
          "device": {
            "type": "object",
            "required": ["sm", "multiprocessor_count"],
            "properties": {
              "sm": {"type": "integer", "minimum": 1},
              "multiprocessor_count": {"type": "integer", "minimum": 1}
            }
          },
          "kernel_build_id": {"type": "string", "minLength": 1},
          "cuda_version": {"type": "string", "minLength": 1},
          "library_versions": {"type": "object"}
        }
      }
    }
  }
}
