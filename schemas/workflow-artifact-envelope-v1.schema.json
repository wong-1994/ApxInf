{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apxinf.dev/schemas/workflow-artifact-envelope-v1.schema.json",
  "title": "ApxInf Workflow Artifact provenance envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["envelope_version", "family", "capability_contract_version", "stage", "payload_schema", "path", "dependency_paths", "state", "explanation", "fingerprints"],
  "properties": {
    "envelope_version": {"const": "1.0"},
    "family": {"enum": ["llm", "vlm", "vla"]},
    "capability_contract_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "stage": {"type": "string", "minLength": 1},
    "payload_schema": {"type": "string", "minLength": 1},
    "path": {"type": "string", "minLength": 1},
    "dependency_paths": {"type": "object", "additionalProperties": {"type": "string"}},
    "state": {"enum": ["current", "stale"]},
    "explanation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changed_dependencies", "upstream_stale"],
      "properties": {
        "changed_dependencies": {"type": "array", "items": {"type": "string"}},
        "upstream_stale": {"type": "array", "items": {"type": "string"}}
      }
    },
    "fingerprints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_sha256", "tool_sha256", "source_sha256", "checkpoint_sha256", "apxinf_source_sha256", "kernel_build_sha256", "environment_sha256", "capability_contract_sha256", "documentation_sha256", "target_environment_sha256", "upstream_sha256"],
      "properties": {
        "content_sha256": {"type": "string", "minLength": 1},
        "tool_sha256": {"type": "object"},
        "source_sha256": {"type": ["string", "null"]},
        "checkpoint_sha256": {"type": ["string", "null"]},
        "apxinf_source_sha256": {"type": "string", "minLength": 1},
        "kernel_build_sha256": {"type": ["string", "null"]},
        "environment_sha256": {"type": ["string", "null"]},
        "capability_contract_sha256": {"type": ["string", "null"]},
        "documentation_sha256": {"type": ["string", "null"]},
        "target_environment_sha256": {"type": "object"},
        "upstream_sha256": {"type": "object"}
      }
    }
  }
}
