{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apxinf.dev/schemas/workflow-artifact-envelope-v1.schema.json",
  "title": "ApxInf Workflow Artifact provenance envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["envelope_version", "family", "capability_contract_version", "stage", "payload_schema", "path", "fingerprints"],
  "properties": {
    "envelope_version": {"const": "1.0"},
    "family": {"enum": ["llm", "vlm", "vla"]},
    "capability_contract_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "stage": {"type": "string", "minLength": 1},
    "payload_schema": {"type": "string", "minLength": 1},
    "path": {"type": "string", "minLength": 1},
    "fingerprints": {"type": "object"}
  }
}
