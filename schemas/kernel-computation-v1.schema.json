{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apxinf.dev/schemas/kernel-computation-v1.schema.json",
  "title": "Family-neutral kernel computation requirement",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "operation", "semantics", "references", "dtype", "layout", "shapes", "tolerances", "golden_tensors", "frequency", "performance_impact", "expected_interface"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "operation": {"type": "string", "minLength": 1},
    "semantics": {"type": "object", "minProperties": 1},
    "references": {"type": "array", "minItems": 1},
    "dtype": {"type": "string", "minLength": 1},
    "layout": {"type": "string", "minLength": 1},
    "shapes": {"type": "array", "minItems": 1, "items": {"type": "array", "items": {"type": "integer", "minimum": 0}}},
    "tolerances": {"type": "object", "required": ["absolute", "relative"]},
    "golden_tensors": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "frequency": {"type": "object", "minProperties": 1},
    "performance_impact": {"type": "object", "minProperties": 1},
    "expected_interface": {"type": "string", "minLength": 1}
  }
}
