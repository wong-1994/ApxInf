{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apxinf.dev/schemas/reference-inventory-v1.schema.json",
  "title": "ApxInf trusted source inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "adapter_contract_version",
    "source",
    "checkpoint",
    "modules",
    "parameters",
    "buffers",
    "aliases",
    "tied_weights",
    "operator_traces",
    "input_schema",
    "output_schema",
    "intermediate_schema",
    "preprocessing",
    "tokenization",
    "normalization",
    "stochastic_inputs",
    "schedules",
    "custom_operators",
    "dynamic_branches",
    "capability_facts"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "adapter_contract_version": {"const": "1.0"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "sha256", "entrypoint"],
      "properties": {
        "revision": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "entrypoint": {"type": "string", "minLength": 1}
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "modules": {
      "type": "array",
      "items": {"$ref": "#/$defs/module"}
    },
    "parameters": {
      "type": "array",
      "items": {"$ref": "#/$defs/tensor"}
    },
    "buffers": {
      "type": "array",
      "items": {"$ref": "#/$defs/tensor"}
    },
    "aliases": {
      "type": "array",
      "items": {"$ref": "#/$defs/nameGroup"}
    },
    "tied_weights": {
      "type": "array",
      "items": {"$ref": "#/$defs/nameGroup"}
    },
    "operator_traces": {"type": "array"},
    "input_schema": {"type": "array"},
    "output_schema": {"type": "array"},
    "intermediate_schema": {"type": "array"},
    "preprocessing": {"type": "object"},
    "tokenization": {"type": "object"},
    "normalization": {"type": "object"},
    "stochastic_inputs": {"type": "array"},
    "schedules": {"type": "array"},
    "custom_operators": {"type": "array"},
    "dynamic_branches": {"type": "array"},
    "capability_facts": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": {"type": "string"},
        "type": {"type": "string", "minLength": 1}
      }
    },
    "tensor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "shape", "dtype", "requires_grad", "data_sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "shape": {
          "type": "array",
          "items": {"type": "integer", "minimum": 0}
        },
        "dtype": {"type": "string", "minLength": 1},
        "requires_grad": {"type": "boolean"},
        "data_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "nameGroup": {
      "type": "array",
      "minItems": 2,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
